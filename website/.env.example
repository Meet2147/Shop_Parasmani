# Copy this file to .env and fill in your details.

# Public address of the shop, e.g. https://www.parasmaninx.in
BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=production

# Long random string used to sign cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password for /admin
ADMIN_PASSWORD=

# Shop details shown on the website
SHOP_NAME=ParasmaniNX
SHOP_TAGLINE=Dress materials, kurti fabrics and Navratri wear
SHOP_PHONE=+91 99694 95026
# WhatsApp number with country code, digits only
SHOP_WHATSAPP=919969495026
SHOP_EMAIL=contact@parasmaninx.in
SHOP_ADDRESS=Lakshminarayan Temple Wadi, Mahatma Gandhi Rd, opposite Gandhi Market, Mumbai, Maharashtra 400077
SHOP_HOURS=Mon to Sat, 10:30 AM to 8:30 PM

# Shipping in rupees
SHIPPING_FEE=79
FREE_SHIPPING_ABOVE=1499
COD_ENABLED=true

# Razorpay keys from https://dashboard.razorpay.com/app/keys
# Use rzp_test_ keys first to try payments without real money.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you choose in Razorpay Dashboard > Webhooks (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# New-order email alerts through Brevo (free plan is enough): https://app.brevo.com
# 1. Create a free Brevo account and verify the sender email you'll send from.
# 2. Settings > SMTP & API > API keys > Generate a new API key.
BREVO_API_KEY=
# Sender address verified in Brevo
EMAIL_FROM=
# Where new-order alerts go; several addresses allowed, comma separated
ORDER_ALERT_EMAIL=
