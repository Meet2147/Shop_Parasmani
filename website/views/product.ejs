<%- include('partials/header') %>

<section class="wrap section">
  <nav class="crumbs"><a href="/">Home</a> / <a href="/c/<%= product.category_slug %>"><%= product.category_name %></a> / <span><%= product.name %></span></nav>

  <div class="product">
    <div class="gallery">
      <div class="gallery-main"><img id="mainImg" src="<%= product.images[0] || '/static/img/placeholder.svg' %>" alt="<%= product.name %>"></div>
      <% if (product.images.length > 1) { %>
        <div class="thumbs">
          <% product.images.forEach((img, i) => { %>
            <button type="button" class="thumb <%= i === 0 ? 'active' : '' %>" data-img="<%= img %>" aria-label="Show photo <%= i + 1 %>"><img src="<%= img %>" alt=""></button>
          <% }) %>
        </div>
      <% } %>
    </div>

    <div class="info">
      <h1 class="product-title"><%= product.name %></h1>
      <div class="price-row big">
        <span class="price"><%= money(product.price) %></span>
        <% if (product.mrp > product.price) { %>
          <s class="mrp"><%= money(product.mrp) %></s>
          <span class="save">Save <%= Math.round((1 - product.price / product.mrp) * 100) %>%</span>
        <% } %>
      </div>
      <p class="muted small">Inclusive of all taxes. <%= product.price >= freeShippingAbove ? 'Free shipping.' : `Free shipping above ${money(freeShippingAbove)}.` %></p>

      <form method="post" action="/cart/add" class="buy-form">
        <input type="hidden" name="product_id" value="<%= product.id %>">
        <% if (product.sizeList.length) { %>
          <fieldset class="sizes">
            <legend>Size</legend>
            <div class="chips">
              <% product.sizeList.forEach((s, i) => { %>
                <label class="chip"><input type="radio" name="size" value="<%= s %>" required <%= product.sizeList.length === 1 ? 'checked' : '' %>><span><%= s %></span></label>
              <% }) %>
            </div>
          </fieldset>
        <% } %>

        <% if (product.stock > 0) { %>
          <div class="qty-row">
            <label for="qty">Quantity</label>
            <div class="qty">
              <button type="button" data-step="-1" aria-label="Less">−</button>
              <input id="qty" name="qty" type="number" min="1" max="<%= Math.min(product.stock, 20) %>" value="1" inputmode="numeric">
              <button type="button" data-step="1" aria-label="More">+</button>
            </div>
            <% if (product.stock <= 3) { %><span class="low">Only <%= product.stock %> left</span><% } %>
          </div>
          <div class="buy-buttons">
            <button class="btn btn-ghost btn-lg" type="submit">Add to cart</button>
            <button class="btn btn-primary btn-lg" type="submit" name="buy_now" value="1">Buy now</button>
          </div>
        <% } else { %>
          <p class="out">This item is sold out right now.</p>
          <a class="btn btn-ghost btn-lg" target="_blank" rel="noopener" href="https://wa.me/<%= shop.whatsapp %>?text=<%= encodeURIComponent(`Hi, please tell me when "${product.name}" is back in stock.`) %>">Notify me on WhatsApp</a>
        <% } %>
      </form>

      <a class="wa-ask" target="_blank" rel="noopener" href="https://wa.me/<%= shop.whatsapp %>?text=<%= encodeURIComponent(`Hi, I have a question about "${product.name}"`) %>">Have a question? Ask us on WhatsApp</a>

      <dl class="specs">
        <% if (product.fabric) { %><dt>Fabric</dt><dd><%= product.fabric %></dd><% } %>
        <% if (product.color) { %><dt>Colour</dt><dd><%= product.color %></dd><% } %>
        <dt>Category</dt><dd><%= product.category_name %></dd>
      </dl>

      <% if (product.description) { %>
        <div class="description">
          <% product.description.split(/\n\s*\n/).forEach(para => { %><p><%- para.split('\n').map(l => l.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))).join('<br>') %></p><% }) %>
        </div>
      <% } %>

      <ul class="perks">
        <li>Cash on Delivery available</li>
        <li>Dispatched in 1 to 2 working days</li>
        <li>7 day easy return on unused items</li>
      </ul>
    </div>
  </div>
</section>

<% if (related.length) { %>
<section class="wrap section">
  <h2 class="section-title">You may also like</h2>
  <div class="grid">
    <% related.forEach(p => { %><%- include('partials/product-card', { p }) %><% }) %>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
