<%- include('partials/header') %>
<%
  const v = (k) => form[k] || '';
  const err = (k) => errors[k] ? `<span class="field-error">${errors[k]}</span>` : '';
  const defaultPay = form.payment || (razorpayEnabled ? 'razorpay' : 'cod');
%>
<section class="wrap section">
  <h1 class="page-title">Checkout</h1>
  <% if (errors.cart) { %><div class="flash flash-error"><%= errors.cart %></div><% } %>
  <% if (Object.keys(errors).length && !errors.cart) { %><div class="flash flash-error">Please fix the highlighted fields.</div><% } %>

  <form method="post" action="/checkout" class="checkout-layout" novalidate>
    <div class="checkout-form">
      <h2>Contact</h2>
      <div class="fields">
        <label class="<%= errors.name ? 'has-error' : '' %>">Full name<input name="name" value="<%= v('name') %>" autocomplete="name" required><%- err('name') %></label>
        <label class="<%= errors.phone ? 'has-error' : '' %>">Mobile number<input name="phone" value="<%= v('phone') %>" autocomplete="tel" inputmode="tel" placeholder="10 digit mobile" required><%- err('phone') %></label>
        <label class="full <%= errors.email ? 'has-error' : '' %>"><span>Email <span class="muted">(optional, for order updates)</span></span><input name="email" type="email" value="<%= v('email') %>" autocomplete="email"><%- err('email') %></label>
      </div>

      <h2>Delivery address</h2>
      <div class="fields">
        <label class="full <%= errors.address1 ? 'has-error' : '' %>">House no., building, street<input name="address1" value="<%= v('address1') %>" autocomplete="address-line1" required><%- err('address1') %></label>
        <label class="full"><span>Area, landmark <span class="muted">(optional)</span></span><input name="address2" value="<%= v('address2') %>" autocomplete="address-line2"></label>
        <label class="<%= errors.city ? 'has-error' : '' %>">City<input name="city" value="<%= v('city') %>" autocomplete="address-level2" required><%- err('city') %></label>
        <label class="<%= errors.pincode ? 'has-error' : '' %>">PIN code<input name="pincode" value="<%= v('pincode') %>" autocomplete="postal-code" inputmode="numeric" maxlength="6" required><%- err('pincode') %></label>
        <label class="full <%= errors.state ? 'has-error' : '' %>">State
          <select name="state" autocomplete="address-level1" required>
            <option value="">Choose state</option>
            <% states.forEach(s => { %><option <%= v('state') === s ? 'selected' : '' %>><%= s %></option><% }) %>
          </select><%- err('state') %>
        </label>
        <label class="full"><span>Order note <span class="muted">(optional)</span></span><textarea name="notes" rows="2" placeholder="Anything we should know, like stitching or delivery time"><%= v('notes') %></textarea></label>
      </div>

      <h2>Payment</h2>
      <div class="pay-options <%= errors.payment ? 'has-error' : '' %>">
        <% if (razorpayEnabled) { %>
          <label class="pay-option"><input type="radio" name="payment" value="razorpay" <%= defaultPay === 'razorpay' ? 'checked' : '' %>>
            <span><strong>Pay online</strong><small>UPI, cards, netbanking and wallets, secured by Razorpay</small></span></label>
        <% } %>
        <% if (codEnabled) { %>
          <label class="pay-option"><input type="radio" name="payment" value="cod" <%= defaultPay === 'cod' ? 'checked' : '' %>>
            <span><strong>Cash on Delivery</strong><small>Pay in cash or UPI when your parcel arrives</small></span></label>
        <% } %>
        <%- err('payment') %>
      </div>
    </div>

    <aside class="summary">
      <h2>Your order</h2>
      <% cart.items.forEach(item => { %>
        <div class="mini-line">
          <img src="<%= item.product.images[0] || '/static/img/placeholder.svg' %>" alt="">
          <div><div><%= item.product.name %></div><div class="muted small"><%= item.size ? `Size ${item.size} · ` : '' %>Qty <%= item.qty %></div></div>
          <span><%= money(item.lineTotal) %></span>
        </div>
      <% }) %>
      <div class="sum-row"><span>Subtotal</span><span><%= money(cart.subtotal) %></span></div>
      <div class="sum-row"><span>Shipping</span><span><%= cart.shipping ? money(cart.shipping) : 'Free' %></span></div>
      <div class="sum-row total"><span>Total</span><span><%= money(cart.total) %></span></div>
      <button class="btn btn-primary btn-lg btn-block" type="submit">Place order</button>
      <p class="muted small center">By placing the order you agree to our <a href="/terms">terms</a> and <a href="/returns">return policy</a>.</p>
    </aside>
  </form>
</section>

<%- include('partials/footer') %>
