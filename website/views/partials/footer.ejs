  </main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <div class="footer-logo"><%= shop.name %></div>
        <p><%= shop.tagline %>. Visit our store or shop online, delivered across India.</p>
        <p class="muted small"><%= shop.address %><br><%= shop.hours %></p>
      </div>
      <div>
        <h4>Shop</h4>
        <% navCategories.forEach(c => { %><a href="/c/<%= c.slug %>"><%= c.name %></a><% }) %>
      </div>
      <div>
        <h4>Help</h4>
        <a href="/track">Track your order</a>
        <a href="/shipping">Shipping policy</a>
        <a href="/returns">Returns and refunds</a>
        <a href="/contact">Contact us</a>
      </div>
      <div>
        <h4>About</h4>
        <a href="/about">About us</a>
        <a href="/terms">Terms and conditions</a>
        <a href="/privacy">Privacy policy</a>
        <a href="tel:<%= shop.phone.replace(/\s/g, '') %>"><%= shop.phone %></a>
        <a href="mailto:<%= shop.email %>"><%= shop.email %></a>
      </div>
    </div>
    <div class="wrap footer-bottom">© <%= new Date().getFullYear() %> <%= shop.name %>. All prices in INR, inclusive of taxes.</div>
  </footer>
  <a class="whatsapp-fab" href="https://wa.me/<%= shop.whatsapp %>?text=<%= encodeURIComponent('Hi ' + shop.name + ', I have a question') %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
