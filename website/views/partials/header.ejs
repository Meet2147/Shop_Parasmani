<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %><%= title.includes(shop.name) ? '' : ` | ${shop.name}` %></title>
  <meta name="description" content="<%= shop.name %>: <%= shop.tagline %>. Shop chaniya choli, Navratri blouses, ghagras, dress materials and kurti fabrics online.">
  <link rel="icon" href="/static/img/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Mulish:wght@400;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
  <div class="announce">Free shipping above <%= money(freeShippingAbove) %> <span class="dot">•</span> Cash on Delivery available <span class="dot">•</span> Navratri collection is live</div>
  <header class="site-header">
    <div class="wrap header-row">
      <a class="logo" href="/" aria-label="<%= shop.name %> home">
        <svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="18" fill="#7a1230"/><path d="M20 7 L24 16 L33 20 L24 24 L20 33 L16 24 L7 20 L16 16Z" fill="#e8a317"/><circle cx="20" cy="20" r="4" fill="#fbf6ee"/></svg>
        <span><%= shop.name %></span>
      </a>
      <form class="search" action="/shop" method="get" role="search">
        <input type="search" name="q" placeholder="Search chaniya choli, cotton, bandhani…" value="<%= typeof search !== 'undefined' ? search : '' %>" aria-label="Search products">
        <button type="submit" aria-label="Search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></button>
      </form>
      <a class="cart-link" href="/cart" aria-label="Cart, <%= cartCount %> items">
        <svg viewBox="0 0 24 24"><path d="M6 7h12l-1 13H7L6 7Z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
        <% if (cartCount) { %><span class="badge"><%= cartCount %></span><% } %>
      </a>
    </div>
    <nav class="cat-nav" aria-label="Categories">
      <div class="wrap">
        <a href="/shop" class="<%= path === '/shop' ? 'active' : '' %>">All</a>
        <% navCategories.forEach(c => { %>
          <a href="/c/<%= c.slug %>" class="<%= path === '/c/' + c.slug ? 'active' : '' %> <%= c.is_festive ? 'festive' : '' %>"><%= c.name %></a>
        <% }) %>
        <a href="/track" class="<%= path === '/track' ? 'active' : '' %>">Track order</a>
      </div>
    </nav>
  </header>
  <% if (flash) { %>
    <div class="wrap"><div class="flash flash-<%= flash.type %>" role="status"><%= flash.message %></div></div>
  <% } %>
  <main>
